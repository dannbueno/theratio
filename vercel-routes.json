{
  "routes": [
    { "src": "/api/auth/strava/callback(.*)", "dest": "/api/auth/strava/callback" },
    { "src": "/api/auth/strava(.*)", "dest": "/api/auth/strava" },
    { "src": "/api/strava/webhook(.*)", "dest": "/api/strava/webhook" },
    { "src": "/dashboard(.*)", "dest": "/dashboard" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/" }
  ]
} 