{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next",
      "config": {
        "skipEslintCheck": true,
        "nodeVersion": "18.x"
      }
    }
  ],
  "env": {
    "NEXT_PUBLIC_BASE_URL": "https://theratio.vercel.app",
    "NEXT_PUBLIC_STRAVA_CLIENT_ID": "129187",
