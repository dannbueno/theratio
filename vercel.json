{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "routes": [
    { "src": "/", "dest": "/" },
    { "src": "/dashboard", "dest": "/dashboard" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/" }
  ]
} 